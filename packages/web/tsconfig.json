{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*", "../core/src/types", "../core/src/types"],
  "exclude": ["dist"],
  "compilerOptions": {
    "paths": {
      "@assets/*": ["./src/assets/*"],
      "@components/*": ["./src/components/*"],
      "@layouts/*": ["./src/layouts/*"],
      "@pages/*": ["./src/pages/*"],
      "@scripts/*": ["./src/scripts/*"],
      "@styles/*": ["./src/styles/*"],
      "@utils/*": ["./src/utils/*"],
      "@languages": ["../core/src/languages.ts"],
      "@constants": ["../core/src/constants.ts"],
      "@projectTypes/*": ["../core/src/types/*"], // @types is a reserved keyword, so we use @projectTypes instead
      "@admin-assets/*": ["../admin/src/assets/*"]
    }
  }
}
