---
import Dropdown from './Dropdown.astro';
import { getAriaCurrentPage } from '@utils/a11y';

const { homeLocale: home, t } = Astro.locals;

interface Props {
  class?: string;
  [key: string]: any;
}

const { class: className, ...attributes } = Astro.props;

const menuItems : { href: string; label: string }[] = [
  { href: `${home()}#top`, label: t('nav_home') },
  { href: `${home()}#objectives`, label: t('nav_objectives') },
  { href: `${home()}#partners`, label: t('nav_partners') },
  { href: `${home()}#contact`, label: t('nav_contact') },
  { href: `${home()}#resources`, label: t('nav_resources') },
  { href: `${home('blog')}`, label: 'Blog' }, // "Blog" is a proper noun and is commonly left untranslated in many languages, so we can keep it as "Blog" across all locales for better recognition
  { href: `${home('courses')}`, label: t('nav_courses') },
  { href: `${home('ai-solutions')}`, label: t('nav_ai_solutions') }
];
---

<Dropdown {...attributes}
  class:list={["navigation-menu", className]}
  position="left"
  iconName="hamburger"
  iconOpenName="close"
  iconSize={32}
  includeChevron={false}
  mobileOnly={true}
  buttonAriaLabel={t('nav_menu_button_label')}>
  {menuItems.map(item => (
      <li><a class="dropdown-link" href={item.href} aria-current={getAriaCurrentPage(Astro.url.pathname, item.href)}>{item.label}</a></li>
    ))}
</Dropdown>