---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getPlainPathNoLocale } from "@utils/localizedUrl";
import { defaultLocale } from "@languages";
import { Icon } from "astro-icon/components";

const { locale: currentLocale, t } = Astro.locals;

// Get the locale-agnostic path (e.g., 'contact' instead of '/en/contact' or '/my-repo/en/contact')
const plainPathNoLocale = getPlainPathNoLocale(Astro.url.pathname, currentLocale);
---

<div class="ai-disclaimer" role="alert">
  <div class="icon">
    <Icon name="warning" width="24" height="24" aria-hidden="true" />
  </div>
  
  <div class="content">
    <p>
      <strong>{t("ai_disclaimer_note")}</strong>: {t("ai_disclaimer_text")}
    </p>
    <p>
      <a href={getRelativeLocaleUrl(defaultLocale, plainPathNoLocale)}>{t("ai_disclaimer_original_link")}</a>
    </p>
  </div>
</div>

<style>
  .ai-disclaimer {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    background-color: #fffbeb; /* Amarillo suave para no ser muy agresivo */
    border-left: 4px solid #f59e0b;
    padding: 1rem;
    margin: 2rem 0;
    border-radius: 0.25rem;
    color: #92400e;
  }

  .icon {
    flex-shrink: 0;
    color: #d97706;
  }

  .content p {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .content p + p {
    margin-top: 0.5rem;
  }

  .content a {
    color: #d97706;
    text-decoration: underline;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .content a:hover {
    color: #b45309;
  }
</style>