---
import { Icon } from "astro-icon/components";

import fs from 'node:fs';
import path from 'node:path';

const docsDirectory = path.join(process.cwd(), 'public/docs');
let pdfs : { name: string, url: string }[] = [];

try {
  const files = fs.readdirSync(docsDirectory);
  
  pdfs = files
    .filter(file => file.toLowerCase().endsWith('.pdf'))
    .map(file => {
      const cleanName = file.replace(/\.pdf$/i, '').replace(/[_]/g, ' ');
      const formattedName = cleanName.charAt(0).toUpperCase() + cleanName.slice(1);

      // Read the file stats to get the last modified time
      const filePath = path.join(docsDirectory, file);
      const stats = fs.statSync(filePath);
      
      // stats.mtimeMs gives us the last modified time in milliseconds
      // We convert it to a string in base 36 to make it shorter
      const fileVersion = Math.floor(stats.mtimeMs).toString(36);

      return {
        name: formattedName,
        // We add the version as a "query string" to help with cache busting
        // (so that if the file changes, the URL will change and the browser will fetch the new version)
        url: `/docs/${file}?v=${fileVersion}`, 
      };
    });
} catch (error) {
  console.warn("⚠️ Folder 'public/docs' was not found or is empty.");
}
---

<ul>
  {pdfs.map(({ name, url }) => (
    <li>
      <a href={url} target="_blank" rel="noopener noreferrer">
        <Icon name="document" width="24" height="24" aria-hidden="true" />
        {name} <span class="sr-only"> {Astro.locals.t('opens_in_new_window')}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: center;
  }

  li a {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--color-text);
    font-weight: bold;
    font-size: 1.2rem;
  }

  li a:hover {
    color: var(--color-link-hover);
  }
</style>