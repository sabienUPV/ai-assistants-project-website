---
import EuLogo from "@components/EuLogo.astro";
import ArasaacLogo from "@components/ArasaacLogo.astro";
import Socials from "@components/Socials.astro";
import { COPYRIGHT_YEARS, PROJECT_NUMBER_EU } from "@constants";
import { getAriaCurrentPage, PROJECT_NAME_HTML } from "@utils/a11y";

const { homeLocale: home, t } = Astro.locals;

const footerLinks : { href: string; label: string }[] = [
  { href: `${home()}imprint`, label: t('nav_imprint') },
];
---

<footer>
  <div class="socials-container no-print">
    <Socials />
  </div> 
  <nav class="footer-nav no-print">
    <ul>
    {footerLinks.map(link => (
      <li><a href={link.href} class="footer-link" aria-current={getAriaCurrentPage(Astro.url.pathname, link.href)}>{link.label}</a></li>
    ))}
    </ul>
  </nav>
  <div class="copyright-text">
    Copyright © {COPYRIGHT_YEARS} <Fragment set:html={t('copyright_text', false, PROJECT_NAME_HTML)} />
  </div>
  <div class="project-number-eu no-print">
    {PROJECT_NUMBER_EU}
  </div>
  <div class="logos-disclaimers-wrapper">
    <div class="eu-logo-wrapper">
      {/*
      In the footer, we want to use renderMode="img" because we want to lazy load the EU logo (and we can only do that in img mode, not svg mode), and because we never need to style the EU logo in the footer (we only need to style it in the header for print mode, where we use renderMode="svg").
      */}
      <EuLogo renderMode="img" loading="lazy" decoding="async" showDisclaimer={true} />
    </div>
    <div class="arasaac-logo-wrapper">
      <ArasaacLogo />
    </div>
  </div>
</footer>
<style>
  footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 1.2rem;
    background-color: var(--color-secondary);
    color: var(--color-text-on-secondary);
  }
  .footer-nav > ul {
    list-style: none;
    display: flex;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
  }
  .logos-disclaimers-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    max-width: 50vw;
  }
  .logos-disclaimers-wrapper :global(.eu-logo),
  .logos-disclaimers-wrapper :global(.arasaac-logo-image-container) {
    margin: 0 auto;
  }
  .eu-logo-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }
  .footer-link {
    color: var(--color-text-on-secondary);
    text-decoration: none;
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }
  .footer-link:hover {
    text-decoration: underline;
  }

  @media print {
    /* Remove the background color for print, and add a top border to separate it from the content */
    footer {
      /* Prevent the footer from breaking apart in two if it is at the end of a page */
      break-inside: avoid;
      page-break-inside: avoid;

      border-top: 2px solid black; /* Add a top border to separate it from the content */
      margin-top: 1rem; /* Add some margin on the top to separate it from the content */
      margin-inline: 2rem; /* Add some margin on the left and right to avoid the border spanning through the entire page */
    }

    /* Hide the social media links and EU logo for print (but keep the EU disclaimer text) */
    .socials-container,
    .eu-logo-wrapper :global(.eu-logo) {
      display: none;
    }
  }
</style>
