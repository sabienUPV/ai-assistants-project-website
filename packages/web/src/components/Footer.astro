---
import EuLogo from "@components/EuLogo.astro";
import Socials from "@components/Socials.astro";
import { COPYRIGHT_YEARS, PROJECT_NUMBER_EU } from "@constants";
import { getAriaCurrentPage, PROJECT_NAME_HTML } from "@utils/a11y";

const { homeLocale: home, t } = Astro.locals;

const footerLinks : { href: string; label: string }[] = [
  { href: `${home()}imprint`, label: t('nav_imprint') },
];
---

<footer>
  <div class="socials-container no-print">
    <Socials />
  </div> 
  <nav class="footer-nav no-print">
    <ul>
    {footerLinks.map(link => (
      <li><a href={link.href} class="footer-link" aria-current={getAriaCurrentPage(Astro.url.pathname, link.href)}>{link.label}</a></li>
    ))}
    </ul>
  </nav>
  <div class="copyright-text">
    Copyright © {COPYRIGHT_YEARS} <Fragment set:html={t('copyright_text', false, PROJECT_NAME_HTML)} />
  </div>
  <div class="project-number-eu no-print">
    {PROJECT_NUMBER_EU}
  </div>
  <div class="eu-logo-wrapper">
    {/*
    In the footer, we want to use renderMode="img" because we want to lazy load the EU logo (and we can only do that in img mode, not svg mode), and because we never need to style the EU logo in the footer (we only need to style it in the header for print mode, where we use renderMode="svg").
    */}
    <EuLogo renderMode="img" loading="lazy" showDisclaimer={true} />
  </div>
</footer>
<style>
  footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 1.2rem;
    background-color: var(--color-secondary);
    color: var(--color-text-on-secondary);
  }
  .footer-nav > ul {
    list-style: none;
    display: flex;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
  }
  .eu-logo-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 50vw;
    gap: 0.5rem;
  }
  .footer-link {
    color: var(--color-text-on-secondary);
    text-decoration: none;
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }
  .footer-link:hover {
    text-decoration: underline;
  }

  @media print {
    /* Remove the background color for print */
    footer {
      background-color: white;
      color: black;
    }

    /* Hide the social media links and EU logo for print (but keep the EU disclaimer text) */
    .socials-container,
    .eu-logo-wrapper :global(.eu-logo) {
      display: none;
    }
  }
</style>
