---
import { SEO_TITLE, SEO_DESCRIPTION, SEO_IMAGE } from '@constants';
import { getPlainPathNoLocale, getAbsoluteLocaleUrlFromOrigin} from '@utils/localizedUrl.ts';
import { locales, defaultLocale } from '@languages';
import { homeNoLocale } from '@utils/url.ts';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = SEO_TITLE,
  description = SEO_DESCRIPTION,
  image = SEO_IMAGE,
} = Astro.props;

const siteUrl = Astro.site || Astro.url.origin;
const locale = Astro.currentLocale || defaultLocale;
const origin = Astro.site ? Astro.site.origin : Astro.url.origin;

// Get the locale-agnostic path (e.g., 'contact' instead of '/en/contact' or '/my-repo/en/contact')
const plainPathNoLocale = getPlainPathNoLocale(Astro.url.pathname, locale);

// Build the canonical URL (without extra parameters, forcing how we want it to be read)
// Astro.url.pathname gives us the current path
// We also make sure that it does NOT end with (/1) or (/1/) because that is the first page of paginated content, and we want to canonicalize it to the main content page (e.g. /blog) instead of the first page (e.g. /blog/1). This is important for SEO, because search engines would see both pages having the same content, and it would be considered duplicate content, which is bad for SEO. By having the same canonical URL, we are telling search engines that both pages are actually the same, and not duplicates.
const canonicalUrl = new URL(Astro.url.pathname.replace(/\/1\/?$/, ''), siteUrl);

// Absolute Image URL:
// homeNoLocale(image) gives us "/social-preview.png" (it is in the /public folder),
// new URL(...) prepends the domain: "https://yourdomain.com/social-preview.png"
const absoluteImageUrl = new URL(homeNoLocale(image), siteUrl);
---
<title>{title}</title>
<meta name="description" content={description} />

<link rel="canonical" href={canonicalUrl.href} />

{/* --- SEO: HREFLANG TAGS (for search engines to serve links in the user's language) --- */}
{/* x-default (mandatory fallback to default locale, usually points to English) */}
<link 
  rel="alternate" 
  hreflang="x-default" 
  href={getAbsoluteLocaleUrlFromOrigin(origin, defaultLocale, plainPathNoLocale)} 
/>

{/* Dynamically map all our supported locales */}
{locales.map((loc) => (
  <link 
    rel="alternate" 
    hreflang={loc} 
    href={getAbsoluteLocaleUrlFromOrigin(origin, loc, plainPathNoLocale)} 
  />
))}

{/*
  Sitemap link for search engines
  (using @astrojs/sitemap official integration to automatically generate the sitemap)
*/}
<link rel="sitemap" href="/sitemap-index.xml" />

<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalUrl.href} />
<meta property="og:image" content={absoluteImageUrl.href} />

{/*
  Specify image dimensions for better social media previews
  IMPORTANT: Make sure these (1200x630) match the actual dimensions of your image at "/public/social-preview.png"
  (1200x630 is the standard size for social media images)
*/}
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteImageUrl.href} />