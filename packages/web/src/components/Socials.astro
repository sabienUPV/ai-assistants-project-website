---
import { Icon } from "astro-icon/components";
---
<div class="socials"> 
  <a href="https://www.linkedin.com/company/AI-Assistants4pid" target="_blank" rel="noopener noreferrer">
    <Icon name="linkedin" class="linkedin-icon" width="36" height="36" aria-hidden="true" />
    <span class="sr-only">Linkedin. {Astro.locals.t('opens_in_new_window')}</span>
  </a>
</div>

<style>
.socials {
  display: flex;
  align-items: center;
  justify-content: center;
}
.socials .linkedin-icon {
  background-color: white;
}
</style>
