---
import ContentDirectorySvelte, { type DirectoryItem, type FilterConfig as FilterConfigBase } from '@components/client/navigation/ContentDirectory.svelte';
import Filters from '@components/entries/navigation/Filters.astro';
import PageNavigation from '@components/entries/navigation/PageNavigation.astro';
import Dropdown from '@components/shared/Dropdown.astro';
import type { Page } from 'astro';

// We re-export the types so that the parent page can use them to type its data without having to import the Svelte component directly.
export type { DirectoryItem };

// Export FilterConfig now as a generic type that can be used to type the filterConfig prop in the parent page, while still being compatible with the Svelte component's FilterConfig type.
export type FilterConfig<T extends Record<string, any>> = FilterConfigBase & {
  searchFields: (keyof T)[];
  arrayFilters?: { paramName: string; dataKey: keyof T }[]; // For arrays like thematicArea
  exactFilters?: { paramName: string; dataKey: keyof T }[]; // For exact matches like type
};

interface Props {
  items: DirectoryItem[];
  isClient?: boolean; // If true, use Svelte to render the directory and handle filtering client-side. If false, use a standard HTML form that navigates to /search.
  actionRelativePath?: string; // The relative path to the search endpoint. Defaults to "search".
  filterConfig?: FilterConfigBase;
  readMoreLabel?: string;
  page?: Page; // The Astro page object, required to render static pagination when isClient is false.
}

const { t } = Astro.locals;
const { items, isClient, actionRelativePath, filterConfig, readMoreLabel, page } = Astro.props;

const filterGroups = filterConfig?.arrayFilters?.concat(filterConfig.exactFilters || [])?.reduce((acc, filter) => {
  const uniqueValues = new Set(items.flatMap(item => {
    const rawValue = item.rawData[filter.dataKey];
    return Array.isArray(rawValue) ? rawValue : [rawValue];
  }));
  acc[filter.paramName] = Array.from(uniqueValues).filter(v => v !== undefined && v !== null).map(String);
  return acc;
}, {} as Record<string, string[]>);

const isSearchEnabled = filterConfig?.searchFields != null;
const hasFilters = filterGroups && Object.keys(filterGroups).length > 0;

const translations = {
  notInLanguage: t('content_not_available_in_your_language'),
  noResults: t('content_directory_no_results_label'),
}
---

<div class="directory-content-columns">
  {/* Setup the directory by injecting the backend data */}
  <div class="directory-content-wrapper">
    {/* Setup only search bar if only search is enabled */}
    {isSearchEnabled && !hasFilters && (
      <div class="directory-search-bar">
        <Filters actionRelativePath={actionRelativePath} isClient={isClient} filterGroups={filterGroups} isSearchEnabled={isSearchEnabled} />
      </div>
    )}

    {/* 
      IMPORTANT ASTRO ARCHITECTURE BEHAVIOR:
      Astro does not support dynamic directives like `client:load={isClient}`. 
      To handle our hybrid approach, we use a conditional block.
      
      - When `isClient` is true, we apply `client:load`. The Svelte component hydrates, manages state, and handles dynamic searching without reloads.
      - When `isClient` is false, we omit `client:load`. Astro compiles the Svelte component into pure static HTML on the server and strips away all its JavaScript, shipping exactly 0 bytes of JS to the browser. In this static mode, we also append the native Astro <PageNavigation /> component.
    */}
    {isClient ? (
      <ContentDirectorySvelte
        client:load
        items={items}
        filterConfig={filterConfig}
        readMoreLabel={readMoreLabel}
        translations={translations}
      />
    ) : (
      <>
        <ContentDirectorySvelte
          items={items}
          filterConfig={filterConfig}
          readMoreLabel={readMoreLabel}
          translations={translations}
        />
        {page && <PageNavigation page={page} />}
      </>
    )}
  </div>
  
  {/* Setup full filters using Dropdown for mobile modal behavior if having filters other than search */}
  {hasFilters && (
    <div class="directory-filters">
      <Dropdown
        title={t('filter_title')}
        iconName="search"
        mobileOnly={true}
        position="left"
      >
        <li class="filters-dropdown-container">
          <Filters actionRelativePath={actionRelativePath} isClient={isClient} filterGroups={filterGroups} isSearchEnabled={isSearchEnabled} />
        </li>
      </Dropdown>
    </div>
  )}
</div>

<style lang="scss">
  .directory-content-columns {
    display: flex;
    flex-direction: row;
    gap: 4rem;
    align-items: flex-start; /* Prevents the sidebar from stretching vertically if content is long */
  }

  .directory-content-wrapper {
    flex: 1;
    min-width: 0; /* Prevents grid blowouts */
  }

  .directory-filters {
    width: 300px;
    flex-shrink: 0;
  }

  /* Reset list styling for the dropdown content */
  .filters-dropdown-container {
    list-style: none;
    padding: 1rem;
    margin: 0;
  }

  /* Responsive layout: Stack columns and make filters full width on mobile */
  @media (max-width: $bp-mobile) {
    .directory-content-columns {
      /* Column-reverse ensures the filters button appears ABOVE the items grid on mobile */
      flex-direction: column-reverse; 
      gap: 2rem;
    }

    .directory-filters {
      width: 100%;
      display: flex;
      justify-content: flex-start; /* Align the filter button to the left */
    }

    .filters-dropdown-container {
      background-color: var(--color-secondary);
      color: white;
    }

    .directory-filters :global(.dropdown-trigger) {
      background-color: var(--color-secondary);
      color: white;
      border-radius: 0.5rem;
    }

    .directory-filters :global(.dropdown-trigger:hover) {
      background-color: var(--color-link-hover);
    }
  }
</style>