---
import ContentDirectorySvelte, { type DirectoryItem, type FilterConfig as FilterConfigBase } from '@components/client/navigation/ContentDirectory.svelte';
import Filters from '@components/entries/navigation/Filters.astro';

// We re-export the types so that the parent page can use them to type its data without having to import the Svelte component directly.
export type { DirectoryItem };

// Export FilterConfig now as a generic type that can be used to type the filterConfig prop in the parent page, while still being compatible with the Svelte component's FilterConfig type.
export type FilterConfig<T extends Record<string, any>> = FilterConfigBase & {
  searchFields: (keyof T)[];
  arrayFilters?: { paramName: string; dataKey: keyof T }[]; // For arrays like thematicArea
  exactFilters?: { paramName: string; dataKey: keyof T }[]; // For exact matches like type
};

interface Props {
  items: DirectoryItem[];
  filterConfig?: FilterConfigBase;
  readMoreLabel?: string;
}

const { t } = Astro.locals;
const { items, filterConfig, readMoreLabel } = Astro.props;

const filterGroups = filterConfig?.arrayFilters?.concat(filterConfig.exactFilters || [])?.reduce((acc, filter) => {
  const uniqueValues = new Set(items.flatMap(item => {
    const rawValue = item.rawData[filter.dataKey];
    return Array.isArray(rawValue) ? rawValue : [rawValue];
  }));
  acc[filter.paramName] = Array.from(uniqueValues).filter(v => v !== undefined && v !== null).map(String);
  return acc;
}, {} as Record<string, string[]>);
---

<div class="directory-content-columns">
  {/* Setup the directory by injecting the backend data */}
  <div class="directory-content-wrapper">
    <ContentDirectorySvelte
      client:load
      items={items}
      filterConfig={filterConfig}
      readMoreLabel={readMoreLabel}
      translations={{
        notInLanguage: t('content_not_available_in_your_language'),
        noResults: t('content_directory_no_results_label'),
      }}
    />
  </div>
  
  {/* Setup filters in client-side mode */}
  {filterGroups && Object.keys(filterGroups).length > 0 && (
    <div class="directory-filters">
      <Filters actionRelativePath="search" isClient={true} filterGroups={filterGroups} />
    </div>
  )}
</div>

<style>
  .directory-content-columns {
    display: flex;
    flex-direction: row;
    gap: 4rem;
  }

  .directory-content-wrapper {
    flex: 1;
  }

  .directory-filters {
    width: 300px;
  }
</style>