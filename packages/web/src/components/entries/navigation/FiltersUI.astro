---
import { getUrlFriendlyVersionOfString } from '@utils/url';

export type FilterGroupsType = Record<string, string[]>;

interface Props {
  // e.g., { "Thematic Area": ["Mobility", "Health"], "Platform": ["Web", "App"] }
  filterGroups: FilterGroupsType;
}

const { t } = Astro.locals;
const { filterGroups } = Astro.props;
---

<div class="filter-search-group">
  <input type="text" id="q" name="q" placeholder={t('filter_search_placeholder')} />
</div>

<div class="filter-title">{t('filter_title')}</div>

<div class="filters-list">
  {Object.entries(filterGroups).map(([groupName, filters]) => (
    <fieldset class="filter-group">
      <legend>{groupName}</legend>
      
      {filters.map((filterValue) => {
        // Create a URL-safe parameter name from the group name (e.g., "Thematic Area" -> "thematic_area")
        const paramName = getUrlFriendlyVersionOfString(groupName);
        const urlFriendlyFilterValue = getUrlFriendlyVersionOfString(filterValue);
        
        return (
          <div class="checkbox-wrapper">
            <input 
              type="checkbox" 
              id={`${paramName}-${urlFriendlyFilterValue}`} 
              name={paramName} 
              value={urlFriendlyFilterValue}
            />
            <label for={`${paramName}-${urlFriendlyFilterValue}`}>{filterValue}</label>
          </div>
        );
      })}
    </fieldset>
  ))}
</div>

<div class="filter-actions">
  <button type="submit" class="submit-btn">{t('filter_label_filter_action')}</button>
  <button type="reset" class="reset-btn">{t('filter_label_clear_action')}</button>
</div>
<style>
  .filter-title {
    text-align: left;
    font-size: 1.5rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .filters-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .filter-search-group {
    margin-bottom: 1rem;
  }

  .filter-search-group input[type="text"] {
    padding: 0.5rem;
    font-size: 1rem;
    width: 100%;
    box-sizing: border-box;
  }

  .submit-btn, .reset-btn {
    margin-right: 1rem;
    padding: 0.5rem 1rem;
    font-size: 1rem;
    cursor: pointer;
  }
</style>