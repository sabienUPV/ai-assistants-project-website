---
interface Props {
  filters: string[]; // Array of filter values to display
  filterParamName?: string; // The URL parameter key to group them under (defaults to 'filter')
}

const { t } = Astro.locals;
const { filters, filterParamName = 'keyword' } = Astro.props;
---

<div class="filter-group">
  <label for="q">{t('filter_label_search_action')}</label>
  <input type="text" id="q" name="q" placeholder={t('filter_search_placeholder')} />
</div>

{filters.map((filterValue) => (
  <div class="filter-group">
    <label for={filterValue}>{filterValue}</label>
    {/* All checkboxes share the same 'name' but have distinct 'value' and 'id' attributes */}
    <input 
      type="checkbox" 
      id={filterValue} 
      name={filterParamName} 
      value={filterValue} 
    />
  </div>
))}

<button type="submit" class="submit-btn">{t('filter_label_filter_action')}</button>
<button type="reset" class="reset-btn">{t('filter_label_clear_action')}</button>