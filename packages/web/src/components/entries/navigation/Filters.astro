---
import FilterInterceptor from '@components/client/navigation/FilterInterceptor.svelte';
import FiltersUI from './FiltersUI.astro';
import { getAbsoluteUrlFromRelativePathWithoutPageNumber } from '@utils/url';
import { type FilterGroups } from './FiltersUI.astro';

interface Props {
  filterGroups?: FilterGroups;
  isSearchEnabled?: boolean; // If true, show a search input field above the filters.
  actionRelativePath?: string; // e.g. "search"
  isClient?: boolean; // If true, use Svelte to intercept the form submission and handle it client-side. If false, use a standard HTML form that navigates to /search.
}

const { filterGroups, isSearchEnabled = false, actionRelativePath = "search", isClient = false } = Astro.props;

const actionUrl = getAbsoluteUrlFromRelativePathWithoutPageNumber(Astro.url.pathname, actionRelativePath);
---

{isClient ? (
  <FilterInterceptor client:idle fallbackAction={actionUrl}>
    <FiltersUI filterGroups={filterGroups} isSearchEnabled={isSearchEnabled} />
  </FilterInterceptor>
) : (
  <form action={actionUrl} method="GET" class="astro-static-form">
    <FiltersUI filterGroups={filterGroups} isSearchEnabled={isSearchEnabled} />
  </form>
)}