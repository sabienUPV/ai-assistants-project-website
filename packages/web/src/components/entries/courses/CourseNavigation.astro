---
import type { Locale } from '@languages';
import type { Course } from '@sabien-upv-astro-cms/core';
import { getCollection, type CollectionEntry } from 'astro:content';
import EntryNavigation from '@components/entries/EntryNavigation.astro';

const { locale, t } = Astro.locals;

interface Props {
  currentUnit: string;
}

const { currentUnit } = Astro.props;

// 1. Fetch all entries from the courses collection
type CourseEntry = CollectionEntry<`courses_${Locale}`> & { data: Course };
const allCourses = await getCollection(`courses_${locale}`) as CourseEntry[];

// 2. Sort courses by unit and then by title for consistent ordering (sorting properly subunits, e.g., 1.10 comes after 1.2)
const sortedCourses = allCourses.sort((a, b) => {
  const partsA = a.data.unit.split('.').map(Number);
  const partsB = b.data.unit.split('.').map(Number);
  const maxLength = Math.max(partsA.length, partsB.length);

  for (let i = 0; i < maxLength; i++) {
    const valA = partsA[i] || 0; // If there are no more levels, assume 0
    const valB = partsB[i] || 0;
    
    if (valA !== valB) {
      return valA - valB;
    }
  }
  return a.data.title.localeCompare(b.data.title);
});

// 3. Find the index of the current course based on the provided currentUnit
const currentIndex = sortedCourses.findIndex(course => course.data.unit === currentUnit);

// 4. Calculate previous and next courses (handling array boundaries)
const prevCourse = currentIndex > 0 ? sortedCourses[currentIndex - 1] : null;
const nextCourse = currentIndex !== -1 && currentIndex < sortedCourses.length - 1 ? sortedCourses[currentIndex + 1] : null;

const buildCourseTitle = (course: CourseEntry) => {
  return `${course.data.unit} - ${course.data.title}`;
};

const previousEntry = prevCourse ? { id: prevCourse.id, title: buildCourseTitle(prevCourse) } : undefined;
const nextEntry = nextCourse ? { id: nextCourse.id, title: buildCourseTitle(nextCourse) } : undefined;
---

<EntryNavigation previousEntry={previousEntry} nextEntry={nextEntry} />