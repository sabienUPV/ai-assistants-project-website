---
import SlideshowSvelte from '@components/client/Slideshow.svelte';

import type { Slide } from '@projectTypes/slideshow';

const { t } = Astro.locals;

const localizedTexts = {
  prevText: t('page_nav_previous'),
  nextText: t('page_nav_next'),
  prevAriaLabel: t('slideshow_prev_label'),
  nextAriaLabel: t('slideshow_next_label'),
};

interface Props {
  slides: Slide[];
}

const { slides = [] } = Astro.props;

// const slides : Slide[] = [
