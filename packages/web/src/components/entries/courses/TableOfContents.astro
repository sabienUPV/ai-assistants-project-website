---
import { defaultLocale } from '@languages';
import { getSlugFromEntryId, type CourseEntry } from '@utils/dynamicContent';
import { getSiblingUrl } from '@utils/url';
import { getCollection } from 'astro:content';

const { locale, t } = Astro.locals;

interface Props {
  courses: CourseEntry[];
  currentUnit: string;
}

const { courses, currentUnit } = Astro.props;

// Also fetch all entries from the courses collection in the default locale (if the current locale is not the default) to provide a fallback for courses that are not available in the current locale
if (locale !== defaultLocale) {
  const defaultLocaleCourses = await getCollection(`courses_${defaultLocale}`) as CourseEntry[];
  const missingCourses = defaultLocaleCourses.filter(defaultCourse => !courses.some(course => course.id === defaultCourse.id));
  if (missingCourses) {
    courses.push(...missingCourses);
  }
}

// Sort courses by unit number properly (e.g., 1 -> 1.1 -> 1.2 -> 1.10 -> 2)
const sortedCourses = courses.sort((a, b) => {
  const partsA = a.data.unit.split('.').map(Number);
  const partsB = b.data.unit.split('.').map(Number);
  const maxLength = Math.max(partsA.length, partsB.length);

  for (let i = 0; i < maxLength; i++) {
    const valA = partsA[i] || 0; // Default to 0 if the segment doesn't exist
    const valB = partsB[i] || 0;
    
    if (valA !== valB) {
      return valA - valB;
    }
  }
  return a.data.title.localeCompare(b.data.title);
});
---

<div class="toc-sidebar" aria-label={t('course_toc_label')}>
  <details class="toc-details" open>
    <summary class="toc-header">{t('course_toc_label')}</summary>
    <ul class="toc-list">
      {sortedCourses.map((course) => {
        // Calculate hierarchy depth based on the number of dots in the unit
        // "1" -> depth 0, "1.2" -> depth 1, "1.2.1" -> depth 2
        const depth = course.data.unit.split('.').length - 1;
        const isActive = course.data.unit === currentUnit;
        
        return (
          <li 
            class={`toc-item ${isActive ? 'is-active' : ''}`} 
            style={`--depth: ${depth};`}
          >
            <a 
              href={getSiblingUrl(Astro.url.pathname, getSlugFromEntryId(course.id))} 
              class="toc-link" 
              aria-current={isActive ? 'page' : undefined}
            >
              <span class="toc-unit-number">{course.data.unit}</span>
              <span class="toc-unit-title">{course.data.title}</span>
            </a>
          </li>
        );
      })}
    </ul>
  </details>
</div>

<style>
  .toc-header {
    cursor: pointer;
    padding-inline: 1.5rem;
    font-weight: 700;
    font-size: 1.2rem;
    color: var(--color-secondary);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .toc-details[open] .toc-header {
    border-bottom: 2px solid var(--color-logo-light-blue);
    padding-bottom: 1rem;
    margin-bottom: 1rem;
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .toc-item {
    margin: 0;
    padding: 0;
  }

  .toc-link {
    display: flex;
    gap: 0.75rem;
    padding: 0.6rem 1.5rem;
    /* Use the CSS variable calculated in the HTML to create visual hierarchy */
    --padding-between-depths: 1.5rem; /* Base padding for each depth level */
    padding-left: calc(var(--padding-between-depths) + (var(--depth) * var(--padding-between-depths)));
    color: var(--color-text);
    text-decoration: none;
    line-height: 1.3;
    transition: all 0.2s ease-in-out;
    border-left: 4px solid transparent;
  }

  .toc-unit-number {
    font-weight: 700;
    color: var(--color-logo-dark-grey);
    white-space: nowrap; /* Evita que el número de unidad se parta en dos líneas */
  }

  .toc-unit-title {
    flex: 1;
    /* Evita que un título sin espacios o larguísimo estire la barra lateral a la fuerza */
    overflow-wrap: break-word;
    word-break: break-word;
  }

  /* Hover state */
  .toc-link:hover {
    background-color: #e9e9e9; /* Slightly darker than background for contrast */
    color: var(--color-secondary);
    text-decoration: none;
  }

  /* Active state (current page) */
  .toc-item.is-active .toc-link {
    background-color: var(--color-logo-light-blue);
    border-left-color: var(--color-primary);
  }

  .toc-item.is-active .toc-unit-number,
  .toc-item.is-active .toc-unit-title {
    color: var(--color-secondary);
    font-weight: 700;
  }

  /* Custom scrollbar for webkit browsers */
  .toc-sidebar::-webkit-scrollbar {
    width: 6px;
  }
  .toc-sidebar::-webkit-scrollbar-track {
    background: transparent;
  }
  .toc-sidebar::-webkit-scrollbar-thumb {
    background-color: var(--color-logo-light-blue);
    border-radius: 10px;
  }

  /* Responsive for mobile - changes to static position and expands */
  @media (max-width: 1115px) {
    .toc-header, .toc-link {
      padding-right: 0;
    }
  }

  @media (max-width: 450px) {
    .toc-link {
      --padding-between-depths: 0.5rem; /* Reduce padding for very small screens */
    }
  }
</style>