---
interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<!-- Svelte buscará todos los divs con la clase 'markdoc-slide' -->
<div class="markdoc-slide" style="display: none;">
  {title && <h2 class="slide-title">{title}</h2>}
  
  <div class="slide-rich-text">
    <slot /> <!-- Aquí Astro inyecta el HTML compilado de Markdoc (negritas, listas, etc.) -->
  </div>
</div>

<style>
  /* HACK: Ponemos .slide-title 2 veces a propósito para aumentar la especificidad
  y asegurarnos de que este estilo tenga prioridad frente al estilo global en la página de cursos.
  Esto es necesario porque ".course-content :global(h2)" se considera más específico que ".slide-title" y le acaba dando prioridad al global cuando no debería.
  */
  .slide-title.slide-title {
    font-size: 2rem;
    color: var(--color-secondary); /* Azul oscuro corporativo */
    margin: 0;
  }
</style>