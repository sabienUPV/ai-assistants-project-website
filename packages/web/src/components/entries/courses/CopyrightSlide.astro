---
import Slide from '@components/Markdoc/Slide.astro';
import ArasaacLogo from '@components/ArasaacLogo.astro';
import EuLogo from '@components/EuLogo.astro';
---

<Slide>
  <div class="copyright-slide-container">
    <ArasaacLogo />
    <div class="eu-logo-container">
      <EuLogo renderMode="svg" showDisclaimer={true} />
    </div>
  </div>
</Slide>

<style>
  .copyright-slide-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    width: 100%;
  }

  .copyright-slide-container :global(p) {
    /* Override the increased font size from the Slide component for the disclaimers and copyright notices */
    font-size: 1rem;
  }

  .copyright-slide-container :global(img) {
    /* Remove border and box-shadow and specify sizes for the logos */
    border: none;
    box-shadow: none;

    /* Remove global margins from Slide to avoid extra spacing around the logos */
    margin: 0;
    padding: 0;

    height: auto;
    max-height: 120px;

    /* Trick for responsiveness: max 300px, but 100% for screens smaller than that */
    max-width: min(100%, 300px); 
    object-fit: contain;
  }

  .eu-logo-container {
    --color-eu-logo-text: #0351a8; /* EU blue for text */
    max-width: 100%;
  }
</style>