---
import { getSlugFromEntryId } from '@utils/dynamicContent';
import { getSiblingUrl } from '@utils/url';

const { t } = Astro.locals;

interface Entry {
  id: string;
  title: string;
}

interface Props {
  previousEntry?: Entry;
  nextEntry?: Entry;
}

const { previousEntry, nextEntry} = Astro.props;
---
  
<nav class="entry-navigation" aria-label={t('entry_nav_label')}>
  {previousEntry ? (
    <a href={getSiblingUrl(Astro, getSlugFromEntryId(previousEntry.id))} class="nav-button prev">
      <span class="nav-icon" aria-hidden="true">&larr;</span>
      <div class="nav-text">
        <span class="nav-label">{t('page_nav_previous')}</span>
        <span class="nav-title">{previousEntry.title}</span>
      </div>
    </a>
  ) : (
    <div class="empty-placeholder"></div>
  )}

  {nextEntry ? (
    <a href={getSiblingUrl(Astro, getSlugFromEntryId(nextEntry.id))} class="nav-button next">
      <div class="nav-text text-right">
        <span class="nav-label">{t('page_nav_next')}</span>
        <span class="nav-title">{nextEntry.title}</span>
      </div>
      <span class="nav-icon" aria-hidden="true">&rarr;</span>
    </a>
  ) : (
    <div class="empty-placeholder"></div>
  )}
</nav>

<style>
  .entry-navigation {
    display: flex;
    justify-content: space-between;
    align-items: stretch;
    margin-top: 4rem;
    gap: 1.5rem;
  }

  .nav-button {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem;
    background-color: var(--color-background);
    border: 2px solid var(--color-logo-light-blue);
    border-radius: 8px;
    color: var(--color-text);
    text-decoration: none;
    flex: 1;
    max-width: calc(50% - 0.75rem);
    transition: all 0.2s ease-in-out;
  }

  /* Override the default link behavior from the layout */
  .nav-button:hover {
    background-color: var(--color-primary);
    border-color: var(--color-primary);
    text-decoration: none;
  }

  .empty-placeholder {
    flex: 1;
    max-width: calc(50% - 0.75rem);
  }

  .nav-text {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .text-right {
    text-align: right;
  }

  .nav-label {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--color-logo-dark-grey);
    margin-bottom: 0.4rem;
    font-weight: 700;
    transition: color 0.2s ease-in-out;
  }

  .nav-title {
    font-weight: 700;
    color: var(--color-secondary);
    font-size: 1.1rem;
    line-height: 1.3;
    transition: color 0.2s ease-in-out;
  }

  .nav-button.next {
    justify-content: flex-end;
  }

  .nav-icon {
    font-size: 1.8rem;
    color: var(--color-primary);
    transition: transform 0.2s ease-in-out, color 0.2s ease-in-out;
  }

  /* Hover effects to improve contrast (WCAG) */
  .nav-button:hover .nav-icon,
  .nav-button:hover .nav-label,
  .nav-button:hover .nav-title {
    color: white; 
  }

  .nav-button.prev:hover .nav-icon {
    transform: translateX(-4px);
  }

  .nav-button.next:hover .nav-icon {
    transform: translateX(4px);
  }

  /* Responsive for mobile */
  @media (max-width: 767px) {
    .entry-navigation {
      flex-direction: column;
      gap: 1rem;
    }
    
    .nav-button, 
    .empty-placeholder {
      max-width: 100%;
      width: 100%;
    }
  }
</style>