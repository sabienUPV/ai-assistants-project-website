---
import EntryNavigation from '@components/entries/EntryNavigation.astro';
import type { PostEntry } from '@utils/dynamicContent';

interface Props {
  posts: PostEntry[];
  currentPostId: string;
}

const { posts, currentPostId } = Astro.props;

// Sort posts by id
const sortedPosts = posts.sort((a, b) => a.id.localeCompare(b.id));

// Find the index of the current post based on its id
const currentIndex = sortedPosts.findIndex(post => post.id === currentPostId);

// Calculate previous and next posts (handling array boundaries)
const prevPost = currentIndex > 0 ? sortedPosts[currentIndex - 1] : null;
const nextPost = currentIndex !== -1 && currentIndex < sortedPosts.length - 1 ? sortedPosts [currentIndex + 1] : null;

const previousEntry = prevPost ? { id: prevPost.id, title: prevPost.data.title } : undefined;
const nextEntry = nextPost ? { id: nextPost.id, title: nextPost.data.title } : undefined;
---

<EntryNavigation previousEntry={previousEntry} nextEntry={nextEntry} />