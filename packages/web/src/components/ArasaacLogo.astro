---
import logo from '@assets/images/logo_ARASAAC.png';
import type { HTMLAttributes } from 'astro/types';
import { Image } from 'astro:assets';

interface Props {
  height?: number;
  includeCopyrightNotice?: boolean;
  loading?: HTMLAttributes<'img'>['loading'];
}

const { loading, height = 60, includeCopyrightNotice = true } = Astro.props;

const { t } = Astro.locals;
---

<Image
  src={logo}
  alt={t('alt_logo_template', false, 'ARASAAC')}
  height={height}
  class="logo"
  loading={loading || "lazy"}
  decoding={loading === "eager" ? "sync" : "async"}
  aria-hidden="true"
/>

{includeCopyrightNotice && (
  <p class="copyright-notice">
    {t('arasaac_copyright_notice')}
  </p>
)}

<style>
  .logo {
    /* Permitimos que se encoja la altura si el ancho lo necesita */
    height: auto; 
    /* Tope máximo de altura */
    max-height: var(--arasaac-logo-height, 60px);
    /* Evita que se desborde en pantallas móviles pequeñas */
    max-width: 100%; 
    /* Si sobra espacio, se adapta a su proporción original */
    width: auto; 
    /* Mantiene las proporciones sin deformarse */
    object-fit: contain; 
  }

  .copyright-notice {
    /* Evita que el texto se desborde y se corte en pantallas pequeñas
    (especialmente con la URL de ARASAAC, que de normal el navegador no la corta) */
    overflow-wrap: break-word; /* 1. Respaldo para navegadores antiguos (soporte universal) */
    overflow-wrap: anywhere; /* 2. Propiedad moderna que calcula mejor el ancho (esta línea sobreescribe la anterior si es compatible, y si es un navegador antiguo la ignora) */
  }
</style>