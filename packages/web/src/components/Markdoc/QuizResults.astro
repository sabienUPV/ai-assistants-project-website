---
import Slide from './Slide.astro';
import QuizResultsInteractive from '@components/client/QuizResults.svelte';

interface Props {
  title?: string;
}

const { title = "¡Resultados Finales!" } = Astro.props;
---

<!-- No la bloqueamos para que no dé problemas al llegar -->
<Slide title={title} locked={false}>
  <QuizResultsInteractive client:visible />
</Slide>