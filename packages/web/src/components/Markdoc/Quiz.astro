---
import QuizApp from '@components/client/Quiz.svelte';
import Slideshow from './Slideshow.astro';
import QuizCover from './QuizCover.astro';
import QuizResults from './QuizResults.astro';

const { t } = Astro.locals;

const localizedTexts = {
  scoreLabel: t('quiz_score_label'),
}
--- 

<QuizApp client:load localizedTexts={localizedTexts}>
  <Slideshow>
    {/* The cover of the quiz (the first slide) */}
    <div class="quiz-cover-slide">
      <QuizCover />
    </div>

    {/* The questions that come from Markdoc */}
    <slot />

    {/* The results of the quiz (the last slide) */}
    <div class="quiz-results-slide">
      <QuizResults />
    </div>
  </Slideshow>
</QuizApp>

<style>
  @media print {
    .quiz-results-slide {
      display: none;
    }
  }
</style>