---
import Slide from './Slide.astro';
import QuestionInteractive from '@components/client/Question.svelte';
import type { Question } from '@core-types/quiz';

interface Props extends Question {};

const { prompt, answers } = Astro.props;
---

{/* The slide starts locked until the question is answered */}
<Slide title="📝 Pregunta" locked={true}>
  <QuestionInteractive 
    client:visible 
    prompt={prompt}
    answers={answers}
  />
</Slide>