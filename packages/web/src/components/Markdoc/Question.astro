---
import Slide from './Slide.astro';
import QuestionInteractive from '@components/client/Question.svelte';
import type { Question } from '@core-types/quiz';

const { t } = Astro.locals;

const localizedTexts = {
  correctAnswerLabel: t('quiz_correct_answer_label'),
  incorrectAnswerLabel: t('quiz_incorrect_answer_label'),
  printAnswerExplanationsLabel: t('quiz_print_answer_explanations_label'),
  printAnswerNoExplanationLabel: t('quiz_print_answer_no_explanation_label'),
}

interface Props extends Question {};

const { prompt, answers } = Astro.props;
---

{/* The slide starts locked until the question is answered */}
<Slide title={"📝 " + t('quiz_question_label')} locked={true}>
  <QuestionInteractive 
    client:visible 
    prompt={prompt}
    answers={answers}
    localizedTexts={localizedTexts}
  />
</Slide>