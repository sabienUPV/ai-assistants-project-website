---
import ArasaacPictogram from '@components/entries/courses/ArasaacPictogram.astro';
import Slide from './Slide.astro';

interface Props {
  title?: string;
  description?: string;
  buttonText?: string;
}

const { 
  title = "HOW MUCH DO YOU KNOW ABOUT AI?", 
  description = "Play this game to learn about Artificial Intelligence.",
  buttonText = "Play"
} = Astro.props;
---

<div class="cover-slide">
  <Slide>
    <div class="cover-layout">
      <div class="text-column">
        <h1 class="cover-title">{title}</h1>
        <p class="cover-subtitle">{description}</p>
        
        {/* El botón lanza un evento nativo que burbujea hasta el Slideshow */}
        <button 
          class="play-btn" 
          onclick="
            this.dispatchEvent(new CustomEvent('resetquiz', { bubbles: true, composed: true }));
            this.dispatchEvent(new CustomEvent('requestnextslide', { bubbles: true, composed: true }))"
        >
          {/* Icono de Play en SVG */}
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="5 3 19 12 5 21 5 3"></polygon>
          </svg>
          {buttonText}
        </button>
      </div>

      <div class="image-column">
        {/* ID 39705 = AI pictogram from ARASAAC */}
        <ArasaacPictogram id="39705" alt="AI pictogram from ARASAAC" size={300} />
      </div>
    </div>
  </Slide>
</div>

<style>
  /* Sobrescribimos el comportamiento por defecto de la slide para que ocupe todo y tenga fondo azul */
  .cover-slide :global(.slide-container) {
    width: 100%;
    height: 100%;
    background-color: #1e60d0; /* El azul de AMICA */
    border-radius: 8px; /* Para que encaje bonito dentro del slideshow-wrapper */
    overflow: hidden;
  }

  .cover-layout {
    display: flex;
    flex-direction: column-reverse; /* En móviles, imagen arriba y texto abajo */
    align-items: center;
    justify-content: center;
    padding: 3rem 2rem;
    height: 100%;
    gap: 2rem;
  }

  .cover-title {
    color: white;
  }

  /* Diseño de escritorio en dos columnas */
  @media (min-width: 768px) {
    .cover-layout {
      flex-direction: row;
      justify-content: space-between;
      padding: 4rem;
    }
  }

  .text-column {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
    color: white;
  }

  .cover-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 800;
    line-height: 1.1;
    margin: 0;
    text-transform: uppercase;
  }

  .cover-subtitle {
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    line-height: 1.4;
    margin: 0;
    margin-bottom: 1rem;
  }

  .play-btn {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background-color: #65a30d; /* Verde vibrante */
    color: white;
    font-size: 1.5rem;
    font-weight: bold;
    padding: 1rem 3rem;
    border: none;
    border-radius: 50px;
    cursor: pointer;
    transition: transform 0.2s, background-color 0.2s;
  }

  .play-btn:hover {
    background-color: #4d7c0f;
    transform: scale(1.05);
  }

  .image-column {
    flex: 1;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  @media print {
    .play-btn {
      display: none; /* Hide the play button on print */
    }
  }
</style>