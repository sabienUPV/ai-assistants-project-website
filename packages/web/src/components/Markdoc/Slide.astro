---
import type { SlideSchema } from '@schemas/slide';

interface Props extends SlideSchema {}

const { title, align = 'center' } = Astro.props;

// Mapeamos los valores de alineación para que CSS Grid los entienda
const gridAlign = align === 'left' ? 'start' : align === 'right' ? 'end' : 'center';
---

{/* Svelte buscará todos los divs con la clase 'markdoc-slide' */}
<div class="markdoc-slide" style="display: none;">
  <div class="slide-container">
    {title && <h2 class="slide-title">{title}</h2>}
  
    <div class="slide-rich-text" style={{"place-items": gridAlign}}>
      <slot /> {/* Aquí Astro inyecta el HTML compilado de Markdoc (negritas, listas, etc.) */}
    </div>
  </div>
</div>

<style>
  .markdoc-slide {
    width: 100%; /* Ocupa todo el espacio disponible en el contenedor padre */
    display: grid; /* Usamos grid para poder centrar el contenido fácilmente */
    place-items: center; /* Centra el contenido horizontal y verticalmente */

    min-width: 0; /* Evita que el contenido se desborde del contenedor */
  }

  .slide-container {
    width: 100%; /* Ocupa todo el ancho disponible */
    box-sizing: border-box; /* Evita que el padding sume ancho extra y provoque desbordamientos */
  }

  .slide-title {
    text-align: center;
    font-size: 2rem;
    color: var(--color-secondary); /* Azul oscuro corporativo */
    margin: 0;
    margin-bottom: 2rem;
  }

  .slide-rich-text {
    width: 100%; /* Ocupa todo el ancho disponible */
    display: grid; /* Usamos grid para poder centrar el contenido fácilmente */
    /* (place-items está en style inline para poder cambiarlo dinámicamente según el atributo 'align') */

    min-width: 0; /* Evita que el contenido se desborde del contenedor */
    overflow-wrap: break-word; /* Evita que URLs largas o palabras gigantes rompan la pantalla en móviles */
  }

  @media print {
    .markdoc-slide {
      /* Evita que una diapositiva se corte entre dos páginas */
      break-inside: avoid;
      page-break-inside: avoid;

      /*
      Since we already make the slide take up the full height of the page,
      we need to avoid an extra page break due to break-after, so we disable it
      */
      break-after: avoid; 
      page-break-after: avoid;


      /* Cambiamos el display: block por flex para poder centrar verticalmente */
      display: flex !important; 
      flex-direction: column;
      justify-content: center; /* Centrado vertical en print */
      
      /* Force the slide to take up the full height of the page (except a little bit to prevent overflow) */
      height: 99vh; 
      box-sizing: border-box; /* Evita que el padding sume altura extra y provoque desbordamientos */
    }

    .markdoc-slide:first-child {
      /* Prevent the first slide from taking up the full height of the page */
      /* This is so that we don't have a lot of blank space after the title of the course, and so that the first slide can be printed on the same page as the title if it fits */
      height: auto;
      
      /* BUT we still want it to have a page break after it, so we never have multiple slides on the same page */
      break-after: page;
      page-break-after: always;
    }
    
    .slide-container {
      padding: 2rem; /* Espaciado interno para que el contenido no toque los bordes del folio */

      border: 1px dashed #000; /* Show a border around each slide for clarity in print */
      border-radius: 8px;
    }
  }
</style>