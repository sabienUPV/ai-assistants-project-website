---
import type { SlideSchema } from '@schemas/slide';

interface Props extends SlideSchema {
  locked?: boolean; // Si la diapositiva está bloqueada, el usuario no podrá avanzar hasta que se desbloquee
}

const { title, align = 'left', locked = false } = Astro.props;

// Mapeamos los valores de alineación para que CSS Grid los entienda
const gridAlign = align === 'left' ? 'start' : align === 'right' ? 'end' : 'center';
---

{/* Svelte buscará todos los divs con la clase 'markdoc-slide' */}
<div class="markdoc-slide" data-locked={locked ? 'true' : 'false'}>
  <div class="slide-container">
    {title && <h1 class="slide-title">{title}</h1>}
  
    <div class="slide-content" style={{"place-items": gridAlign}}>
      <slot /> {/* Aquí Astro inyecta el HTML compilado de Markdoc (negritas, listas, etc.) */}
    </div>
  </div>
</div>

<style>
  /* Only show the slide if it is not hidden by the Slideshow component (which controls which slide is visible) */
  /* (Note: we use :where() so that the print style below can override this style) */
  .markdoc-slide:where(:not(.slide-hidden)) {
    display: grid; /* Usamos grid para poder centrar el contenido fácilmente */
  }

  .markdoc-slide {
    width: 100%; /* Ocupa todo el espacio disponible en el contenedor padre */
    place-items: center; /* Centra el contenido horizontal y verticalmente */

    min-width: 0; /* Evita que el contenido se desborde del contenedor */
  }

  .slide-container {
    width: 100%; /* Ocupa todo el ancho disponible */
    box-sizing: border-box; /* Evita que el padding sume ancho extra y provoque desbordamientos */
  }

  .slide-title {
    text-align: center;
    color: var(--color-secondary);
    margin: 0;
    margin-bottom: 2rem;
  }

  .slide-content :global(img),
  .slide-content :global(.crop-wrapper) {
    margin: 2rem auto; /* Centra la imagen y añade espacio arriba y abajo */
  }

  .slide-content {
    width: 100%; /* Ocupa todo el ancho disponible */
    display: grid; /* Usamos grid para poder centrar el contenido fácilmente */
    /* (place-items está en style inline para poder cambiarlo dinámicamente según el atributo 'align') */

    min-width: 0; /* Evita que el contenido se desborde del contenedor */
    overflow-wrap: break-word; /* Evita que URLs largas o palabras gigantes rompan la pantalla en móviles */
  }

  /* Easy to Read font sizes (Protocol 3.1) */
  /* Only applied when the user has toggled the "Easy to Read" mode */
  /* Note: We convert pt to rem for font sizes so that they scale with the user's font size settings, following accessibility best practices */
  @media screen {
    body.easy-to-read .slide-title, .slide-content :global(h1) {
      /* Protocol 3.1: Main Titles: 60pt, bold */
      font-size: 5rem; /* 60pt */
      font-weight: bold; /* 700/bold */
    }
    body.easy-to-read .slide-content :global(h2) {
      /* Protocol 3.1: Subtitles: 50pt, bold */
      font-size: 4.167rem; /* 50pt */
      font-weight: bold; /* 700/bold */
    }

    body.easy-to-read .slide-content :global(h3) {
      /* The protocol only covers "titles" and "subtitles", so we make h3 a bit bigger than the body text */
      font-size: 3.5rem; /* 42pt */
      font-weight: bold; /* 700/bold */
    }

    /* Note: We NEED to use :global(*) here because Markdoc generates HTML elements dynamically, so the component data-attribute that Astro applies if we don't use :global() gets ignored by the Markdoc elements. So the only way to make it apply properly is to use :global(*) here */
    body.easy-to-read .slide-content, body.easy-to-read .slide-content :global(*) {
      /* Protocol 3.1: Body Text/Bullets: 45pt, regular */
      /* NOTE: 45pt is 3.75rem. For a PPT presentation it looks good, but for a web page it is too big, so we reduce it to 36pt (3rem) for better readability on the web */
      font-size: 3rem; /* 36pt */
      font-weight: normal; /* 400/regular */
    }

    body.easy-to-read .slide-content :global(h3),
    body.easy-to-read .slide-content :global(h4),
    body.easy-to-read .slide-content :global(h5),
    body.easy-to-read .slide-content :global(h6),
    body.easy-to-read .slide-content :global(strong) {
      font-weight: bold; /* Revert to bold for headings and strong text (previous selector applied normal weight to almost everything) */
    }
  }

  /* =========================================
     IMPRESIÓN (Print Mode Responsive)
     ========================================= */
  @media print {
    /* 1. Tamaños de fuente específicos para impresión para que quepa bien */
    .markdoc-slide {
      font-size: 14pt; /* Tamaño base estándar de lectura */
    }
    .slide-title, .slide-content :global(h1) { font-size: 24pt; margin-bottom: 1rem; }
    .slide-content :global(h2) { font-size: 20pt; }
    .slide-content :global(h3) { font-size: 16pt; }
    .slide-content, .slide-content :global(*) {
      font-size: inherit; /* Hereda los 14pt, cancelando los 3rem si se colasen */
    }

    /* 2. El truco del contenedor elástico (Responsive Print) */
    .markdoc-slide {
      /* min-height hace la magia: si es corto ocupa toda la página (99vh), si es largo CRECE */
      min-height: 99vh; 
      
      display: flex;
      flex-direction: column;
      justify-content: center; /* Sigue centrando verticalmente el contenido corto */
      box-sizing: border-box;

      /* Forzamos que cada diapositiva empiece en una página nueva */
      break-before: page;
      page-break-before: always;

      /* IMPORTANTE: Quitamos el avoid general para permitir que la diapositiva se divida si es súper larga */
      break-inside: auto; 
      page-break-inside: auto;
      break-after: auto;
      page-break-after: auto;
    }

    .markdoc-slide:first-child {
      min-height: auto; /* We allow the first slide to be shorter than a full page so it shows in the first page alongside the title if it can (avoiding a ton of blank space in the first page) */

      /* The first slide should not have a page break before it, but it should have a page break after it to ensure that the next slide starts on a new page */
      break-before: auto;
      page-break-before: auto;
      break-after: page; 
      page-break-after: always;
    }

    .slide-container {
      padding: 2rem;
      border: 1px dashed #000; /* Show the dashed border for print to indicate the slide boundaries */
      border-radius: 8px;
      /* Si la caja discontinua crece a dos páginas, queremos que se vea contigua */
      box-decoration-break: clone; 
    }

    /* 3. Evitar que elementos individuales se partan por la mitad al cambiar de página */
    .slide-content :global(p),
    .slide-content :global(li),
    .slide-content :global(h1),
    .slide-content :global(h2),
    .slide-content :global(h3) {
      break-inside: avoid;
      page-break-inside: avoid;
    }

    /* 4. Control del tamaño de las imágenes para que no monopolicen el folio */
    .slide-content :global(img) {
      max-height: 35vh; /* La imagen nunca ocupará más de 1/3 del folio */
      width: auto;
      object-fit: contain;
      break-inside: avoid;
      page-break-inside: avoid;
    }
  }
</style>