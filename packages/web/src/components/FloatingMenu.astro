---
import BackToTopButton from "@components/BackToTopButton.astro";
import EasyToReadButton from "@components/EasyToReadButton.astro";
import RoundedButton from "@components/RoundedButton.astro";

const { t } = Astro.locals;
---

{/* Floating menu (starts hidden) */}
<div class="floating-menu hidden">
  <div class="floating-menu-buttons">
    <BackToTopButton />
    <EasyToReadButton />
  </div>
  
  {/* Toggle menu button */}
  <RoundedButton class="floating-menu-button" type="button" label={t('floating_menu_toggle_label')}>
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
  </RoundedButton>
</div>

<script>
  const floatingMenuButton = document.querySelector('.floating-menu-button');
  const floatingMenu = document.querySelector('.floating-menu');

  floatingMenuButton && floatingMenu && floatingMenuButton.addEventListener('click', () => {
    floatingMenu.classList.toggle('hidden');
  });
</script>

<style>
  .floating-menu {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
  }

  .floating-menu, .floating-menu-buttons {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .floating-menu.hidden .floating-menu-buttons {
    display: none;
  }

  /* Make sure it's big enough to tap on mobile (Accessibility requirement) */
  @media (max-width: 600px) {
    .floating-menu {
      bottom: 1rem;
      right: 1rem;
    }
  }
</style>