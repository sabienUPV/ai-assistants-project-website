---
import { defaultLocale } from '@languages';

const { t, locale } = Astro.locals;

type RenderMode = 'svg' | 'img';

interface Props {
  showDisclaimer?: boolean;
  renderMode: RenderMode;
  [key: string]: any;
}

const { renderMode, showDisclaimer = false, ...attributes } = Astro.props;

// Import ALL logos at build time, so that Vite cannot mess up the imports with dynamic paths (Vite does static analysis and doesn't allow dynamic imports with ?raw, so we have to import all of them at build time)
// We use eager: true so that they are available immediately and without await
// (in this case eager: true is better than lazy loading because we are just adding the SVGs or URLs directly to the page, so the lazy loading would actually make it slower because it requires running an extra JS file just to load them, and since this import only happens once during the build, and we need to load all logos anyway, this is actually faster than lazy loading them)
const rawLogos = import.meta.glob<string>('@assets/images/eu/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true
});
const urlLogos = import.meta.glob<string>('@assets/images/eu/*.svg', {
  query: '?url',
  import: 'default',
  eager: true
});

// Make the logos object more manageable by converting the keys to just the locale code (e.g. "EN") instead of the full path (e.g. "/src/assets/images/eu/EN_Co-fundedbytheEU_RGB_NEG.svg") and merging the raw and url logos into a single object for easier access (e.g. logos['EN'] = { raw: '...', url: '...' })
const logosMap = new Map<string, { raw: string, url: string }>();
// Note: Since the file names should be the same for both the raw and url imports, we can just use the rawLogos keys to extract the file path and then get the corresponding url from urlLogos.
for (const filePath in rawLogos) {
  const match = filePath.match(/\/([A-Z]{2})_Co-fundedbytheEU_RGB_NEG\.svg$/);
  if (match) {
    const code = match[1];
    logosMap.set(code, { raw: rawLogos[filePath], url: urlLogos[filePath] });
  }
}

/**
 * Utility function to patch white text to currentColor dynamically.
 * Intelligently targets <tspan>, <text>, and curved <path> elements
 * while ignoring the rectangular white background border.
 */
const patchSvgToCurrentColor = (rawSvgString: string) => {
  return rawSvgString.replace(
    /<(path|tspan|text)([^>]+)>/gi,
    (match, tag, attributes) => {
      // 1. Check if the element has a white fill
      const isWhite = /fill:\s*#(?:fff|ffffff)\b|fill="#(?:fff|ffffff)"/i.test(attributes);
      
      if (!isWhite) return match;

      // 2. If it is a path, check if it contains curves (text has curves, border does not)
      if (tag.toLowerCase() === 'path') {
        const dMatch = attributes.match(/d="([^"]+)"/i);
        if (dMatch) {
          const dString = dMatch[1];
          const hasCurves = /[cqsa]/i.test(dString);
          
          // Straight-line shape (background border), keep it white
          if (!hasCurves) return match; 
        }
      }

      // 3. Safe to replace the text color!
      return match
        .replace(/fill:\s*#(?:fff|ffffff)\b/gi, 'fill:currentColor')
        .replace(/fill="#(?:fff|ffffff)"/gi, 'fill="currentColor"');
    }
  );
};

// Get the logo from the current locale (the file starts with the locale code in uppercase, e.g. "EN_")
// (Note: our "locale" from Astro.locals already falls back to the default locale)
const importEuLogo = async (locale: string, renderMode: RenderMode) => {
  const code = locale.toUpperCase();

  if (!logosMap.has(code)) {
    throw new Error(`No logo found for locale "${locale}"`);
  }

  const logo = logosMap.get(code)!; // Non-null assertion because we already checked that the logo exists

  if (renderMode === 'svg') {
    // Patch the SVG string in-memory during the build process
    return patchSvgToCurrentColor(logo.raw);
  }
  
  // URL import for the image, which will be processed by Astro's Image component
  return logo.url;
};

let euLogo;
try {
  euLogo = await importEuLogo(locale, renderMode);
} catch (error) {
  console.error(`Error loading EU logo for locale "${locale}", falling back to default locale "${defaultLocale}"`, error);
  euLogo = await importEuLogo(defaultLocale, renderMode);
}
---
{/*
  NOTE: Here we use directly HTML's img instead of Astro's Image component because for SVGs Astro does not make any optimizations,
  so it's just an extra layer of complexity for no benefit.
*/}
{renderMode === 'img' && (
  <img class="eu-logo" {...attributes} src={euLogo} alt={t('alt_eu_cofunded')} height="60" />
)}
{renderMode === 'svg' && (
  <div class="eu-logo" {...attributes} aria-label={t('alt_eu_cofunded')} set:html={euLogo} />
)}

{/*
 Disclaimer text required by EU funding guidelines
 https://www.eacea.ec.europa.eu/grants/visual-identity/visual-identity-programming-period-2021-2027/european-flag-emblem-and-multilingual-disclaimer_en#ref-2-disclaimer-to-use-in-all-communication-materials
 (We control it with a flag so that we only show it in the footer, not the header)
*/}
{showDisclaimer && (
  <p class="eu-disclaimer">
    {t('eu_disclaimer')}
  </p>
)}

<style>
  .eu-logo {
    width: auto;
  }
  .eu-logo :global(svg) {
    width: auto;
    height: 60px;
    color: white;
  }

  /* Automatically handle print styles for the SVG mode! */
  @media print {
    .eu-logo :global(svg) {
      color: black;
    }
  }
</style>