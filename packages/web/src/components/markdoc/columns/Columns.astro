<div class="markdoc-columns">
  <slot />
</div>

<style>
  .markdoc-columns {
    width: fit-content;
    max-width: 100%;
    margin: 1.5rem auto;

    display: grid;
    /* Esto crea automáticamente tantas columnas como metas, y las apila en pantallas pequeñas (móviles) */
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 2rem;
    align-items: center;
  }

  /* En pantallas medianas/grandes: si hay 2 columnas y una es solo imagen, que no ocupe 50% vacío */
  @media (min-width: 650px) {
    /* 1. Izquierda con imagen, derecha sin imagen (texto) */
    .markdoc-columns:has(> .markdoc-column:nth-child(2):last-child):has(> .markdoc-column:first-child img):not(:has(> .markdoc-column:last-child img)) {
      grid-template-columns: auto minmax(250px, 55ch);
    }

    /* 2. Izquierda sin imagen (texto), derecha con imagen */
    .markdoc-columns:has(> .markdoc-column:nth-child(2):last-child):not(:has(> .markdoc-column:first-child img)):has(> .markdoc-column:last-child img) {
      grid-template-columns: minmax(250px, 55ch) auto;
    }

    /* 3. Ambas columnas tienen imagen */
    .markdoc-columns:has(> .markdoc-column:nth-child(2):last-child):has(> .markdoc-column:first-child img):has(> .markdoc-column:last-child img) {
      grid-template-columns: auto auto;
    }
  }
</style>