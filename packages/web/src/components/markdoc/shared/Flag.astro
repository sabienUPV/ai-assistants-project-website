---
import { Icon } from 'astro-icon/components';
import type { FlagSchema } from '@schemas/common';

interface Props extends FlagSchema {}

const { country } = Astro.props;
---
<Icon name={`circle-flags:${country}`} class="flag-icon" width="24" height="24" />

<style>
.flag-icon {
  display: inline-block;
  vertical-align: middle;
}
</style>