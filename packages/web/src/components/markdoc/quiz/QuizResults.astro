---
import Slide from '@components/markdoc/slides/Slide.astro';
import QuizResultsInteractive from '@components/client/markdoc/quiz/QuizResults.svelte';

const { t } = Astro.locals;

const localizedTexts = {
  perfectScoreLabel: t('quiz_perfect_score_label'),
  niceTryLabel: t('quiz_nice_try_label'),
  playAgainLabel: t('quiz_play_again_label'),
};
---

<!-- Keep the results slide unlocked so navigation can reach it. -->
<Slide title={t('quiz_final_score_label') || 'Final Score'} locked={false}>
  <QuizResultsInteractive client:load localizedTexts={localizedTexts} />
</Slide>