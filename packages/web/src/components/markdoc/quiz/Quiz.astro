---
import QuizApp from '@components/client/markdoc/quiz/Quiz.svelte';
import Slideshow from '@components/markdoc/slides/Slideshow.astro';
import QuizCover from './QuizCover.astro';
import QuizResults from './QuizResults.astro';

const { t } = Astro.locals;
const { embedded = false } = Astro.props;

const localizedTexts = {
  scoreLabel: t('quiz_score_label'),
}
--- 

<QuizApp client:load localizedTexts={localizedTexts} embedded={embedded}>
  {embedded ? (
    <>
      <slot />
      <div class="quiz-results-slide">
        <QuizResults />
      </div>
    </>
  ) : (
    <Slideshow>
      <div class="quiz-cover-slide">
        <QuizCover />
      </div>

      <slot />

      <div class="quiz-results-slide">
        <QuizResults />
      </div>
    </Slideshow>
  )}
</QuizApp>

<style>
  @media print {
    .quiz-results-slide {
      display: none;
    }
  }
</style>