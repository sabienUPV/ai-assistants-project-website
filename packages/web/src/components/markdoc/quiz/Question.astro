---
import Slide from '@components/markdoc/slides/Slide.astro';
import QuestionInteractive from '@components/client/markdoc/quiz/Question.svelte';
import type { Question } from '@core-types/quiz';
import { resolveAdminImageSrc } from '@utils/imageResolution';

const { t } = Astro.locals;

const localizedTexts = {
  correctAnswerLabel: t('quiz_correct_answer_label'),
  incorrectAnswerLabel: t('quiz_incorrect_answer_label'),
  printAnswerExplanationsLabel: t('quiz_print_answer_explanations_label'),
  printAnswerNoExplanationLabel: t('quiz_print_answer_no_explanation_label'),
}

interface Props extends Question {};

const { prompt, image, imageAlt, answers } = Astro.props;
const resolvedImage = await resolveAdminImageSrc(image);
const resolvedAnswers = await Promise.all(answers.map(async (answer) => ({
  ...answer,
  image: await resolveAdminImageSrc(answer.image),
})));
---

{/* The slide starts locked until the question is answered */}
<Slide title={"📝 " + t('quiz_question_label')} locked={true}>
  <QuestionInteractive
    client:load
    prompt={prompt}
    image={resolvedImage}
    imageAlt={imageAlt}
    answers={resolvedAnswers}
    localizedTexts={localizedTexts}
  />
</Slide>