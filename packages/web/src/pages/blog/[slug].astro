---
import { getCollection, getEntry, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export const prerender = true;

const { slug } = Astro.params;
if (!slug) throw new Error('Slug not found');
const post = await getEntry('posts', slug);

if (!post) throw new Error('No post found for this slug');
const { Content } = await render(post);

// Generate static pages at build time (SSG)
export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map(post => ({ params: { slug: post.id } }));
}
---

<Layout title={post.data.title} includeLocaleSelector={false}>
  <article class="post-container">
    <header class="post-header">
      <h1>{post.data.title}</h1>
      
      <div class="post-meta">
        {post.data.pubDate && (
          <time datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toLocaleDateString('en-US', { day: 'numeric', month: 'long', year: 'numeric' })}
          </time>
        )}
        {post.data.author && <span class="author">By {post.data.author}</span>}
      </div>
      
      {post.data.description && (
        <p class="post-description">{post.data.description}</p>
      )}
    </header>

    <div class="post-content">
      <Content />
    </div>
  </article>
</Layout>

<style>
  /* Scoped styles for the article layout */
  .post-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem 1rem;
    /* Font-family, font-size, and background are inherited cleanly from global body */
    color: var(--color-text);
  }

  .post-header {
    margin-bottom: 2.5rem;
    border-bottom: 1px solid #e5e7eb;
    padding-bottom: 2rem;
    /* Centers all inline and block elements within the header to match the global h1 alignment */
    display: flex;
    flex-direction: column;
    align-items: center; 
    text-align: center;
  }

  .post-header h1 {
    /* Overriding default global h1 margins to handle specific article headers tightly */
    margin-top: 1rem;
    margin-bottom: 0.75rem;
    font-size: 2.5rem;
  }

  .post-meta {
    display: flex;
    gap: 1.5rem;
    font-size: 0.9rem;
    color: var(--color-logo-dark-grey); /* Integration with your brand grey */
    margin-bottom: 0.5rem;
  }

  .post-description {
    font-size: 1.2rem;
    color: var(--color-text);
    max-width: 650px; /* Keeps the centered description short and balanced */
    margin: 1rem 0 0 0;
    line-height: 1.6;
  }

  /* Styling HTML elements generated dynamically by Markdoc */
  .post-content :global(p) {
    /* Respects your global text alignment (left) and accessibility choices */
    font-size: 1.05rem;
    margin-bottom: 1.6rem;
  }

  .post-content :global(h2) {
    /* Overrides the global h2 centered text inside the reading area for better accessibility */
    text-align: left;
    font-size: 1.75rem;
    color: var(--color-secondary); /* Dark blue corporate identity */
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }

  .post-content :global(h3) {
    text-align: left;
    font-size: 1.3rem;
    color: var(--color-dark-blue);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .post-content :global(ul), .post-content :global(ol) {
    margin-bottom: 1.6rem;
    padding-left: 2rem;
  }

  .post-content :global(li) {
    margin-bottom: 0.6rem;
  }

  .post-content :global(a) {
    color: var(--color-link);
    text-decoration: none;
  }

  .post-content :global(a:hover) {
    color: var(--color-link-hover);
    text-decoration: underline;
  }

  .post-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    margin: 2rem auto;
    display: block; /* Centers images cleanly if they aren't full width */
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
  }
</style>