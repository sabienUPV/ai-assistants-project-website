---
import Layout from '@layouts/Layout.astro';
import { locales } from '@languages';
import { getCollectionWithFallbacks, getSlugFromEntryId } from '@utils/dynamicContent';
import ContentDirectory, { type DirectoryItem, type FilterConfig } from '@components/entries/navigation/ContentDirectory.astro';
import { getAbsoluteUrlFromRelativePathWithoutPageNumber } from '@utils/url';
import type { AiSolution } from '@schemas/ai-solutions';

export const prerender = true;

export async function getStaticPaths() {
  return locales.map(locale => ({ params: { locale } }));
}

const { locale, t } = Astro.locals;
const { collection: allSolutions, fallbackIds: missingSolutionIds } = await getCollectionWithFallbacks('ai-solutions', locale);

const directoryItems : DirectoryItem[] = allSolutions.map(solution => ({
  id: solution.id,
  title: solution.data.name,
  subtitle: `${solution.data.company} • ${solution.data.type}`,
  excerpt: solution.data.description,
  isMissingTranslation: missingSolutionIds?.includes(solution.id) || false,
  // TODO: IMPORTANT: For now we DO NOT do '../' like the comment below says because we are not using pagination yet.
  // HOWEVER, once we implement pagination here, we will want to do it again, so that's why I keep the comment here as reference.
  // Note: We need the '../' prefix because the post URL is relative to the current page, which is /[locale]/ai-solutions/list/[page].astro, and we want to go up one level to /[locale]/ai-solutions/[slug].astro
  url: getAbsoluteUrlFromRelativePathWithoutPageNumber(Astro.url.pathname, /*'../' +*/ getSlugFromEntryId(solution.id)),
  keywords: solution.data.keywords || [],
  rawData: solution.data,
}));

// Create the JSON-serializable configuration object
const filterConfig: FilterConfig<AiSolution> = {
  searchFields: ['name', 'description'],
  arrayFilters: [
    { paramName: t('ai_solutions_entry_thematic_areas_label'), dataKey: 'thematicAreas' },
    { paramName: t('ai_solutions_entry_keywords_label'), dataKey: 'keywords' }
  ],
  exactFilters: [
    { paramName: t('ai_solutions_entry_type_label'), dataKey: 'type' }
  ]
};

---

<Layout title={t('ai_solutions_title')}>
  <main class="solutions-directory">
    <h1 class="directory-title">{t('ai_solutions_title')}</h1>
    
    <ContentDirectory 
      items={directoryItems}
      filterConfig={filterConfig}
      readMoreLabel={t('ai_solutions_card_view_details')}
    />
  </main>
</Layout>

<style>
  .solutions-directory {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem 0;
  }
  .directory-title {
    font-size: 2.25rem;
    font-weight: 700;
    margin-bottom: 2rem;
  }
</style>