---
import Layout from '@layouts/Layout.astro';
import { locales } from '@languages';
import { getCollectionWithFallbacks } from '@utils/dynamicContent';
import Filters from '@components/entries/navigation/Filters.astro';
import ContentDirectory from '@components/entries/navigation/ContentDirectory.astro';

export const prerender = true;

export async function getStaticPaths() {
  return locales.map(locale => ({ params: { locale } }));
}

const { locale, t } = Astro.locals;
const { collection: allSolutions, fallbackIds: missingSolutionIds } = await getCollectionWithFallbacks('ai-solutions', locale);
---

<Layout title={t('ai_solutions_title')}>
  <main class="solutions-directory">
    <h1 class="directory-title">{t('ai_solutions_title')}</h1>
    
    <div class="directory-content">
      {/* Setup the directory by injecting the backend data */}
      <ContentDirectory
        items={allSolutions}
        missingIds={missingSolutionIds}
        readMoreLabel={t('ai_solutions_card_view_details')}
        locale={locale}
      />

      {/* Setup filters in client-side mode */}
      <Filters actionRelativePath="search" isClient={true} filters={allSolutions.map(s => s.data.keywords).flat()} />
    </div>
  </main>
</Layout>

<style>
  .solutions-directory {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem 0;
  }
  .directory-title {
    font-size: 2.25rem;
    font-weight: 700;
    margin-bottom: 2rem;
  }
  .directory-content {
    display: flex;
    flex-direction: row;
    gap: 4rem;
  }
</style>