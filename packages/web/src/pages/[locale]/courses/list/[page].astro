---
import type { GetStaticPaths, Page } from "astro";
import { getFirstLevelCourses } from '@utils/dynamicContent';
import { locales } from "@languages";
import CoursesDirectory from "@components/entries/courses/CoursesDirectory.astro";

export const prerender = true;

export const getStaticPaths = (async function ({ paginate }) {
  const coursesLocalesMap = Object.fromEntries(
    await Promise.all(
      locales.map(async (currentLocale) => {
        const { collection: courses } = await getFirstLevelCourses(currentLocale);
        return [currentLocale, courses] as const;
      })
    )
  );

  // For every locale, return a `paginate()` result.
  // Make sure that you pass `{ params: { locale }}` to `paginate()`
  // so that Astro knows which locale grouping the result is for.
  return locales.flatMap((currentLocale) => {
    return paginate(coursesLocalesMap[currentLocale], {
      params: { locale: currentLocale },
      pageSize: 6,
    });
  });
}) satisfies GetStaticPaths;

// Expected props: the 'page' object that Astro injects into the component
interface Props {
  page: Page;
}

const { page } = Astro.props;

---

<CoursesDirectory isClient={false} page={page} />