---
import { getStaticPathsFromLocales as getStaticPaths } from '@utils/translation';

export { getStaticPaths };

const { t } = Astro.locals;

import Layout from '@layouts/Layout.astro';

import Description from '@components/home/Description.astro';
import Objectives from '@components/home/Objectives.astro';
import Partners from '@components/home/Partners.astro';
import Documents from '@components/home/Documents.astro';
import Contact from '@components/home/Contact.astro';

import { getSeoTitle } from '@utils/seo';

const seoTitle = getSeoTitle(t);
---

<Layout title={seoTitle}>
	<section id="description">
		<Description />
	</section>
	<section id="objectives">
		<Objectives />
	</section>
	<section id="partners">
		<h2>{t('nav_partners')}</h2>
		<p>{t('partners_subtitle')}</p>
		<Partners />
	</section>
	<section id="contact">
		<Contact />
	</section>
	<section id="resources">
		<h2>{t('nav_resources')}</h2>
		<p>{t('resources_subtitle')}</p>
		<Documents />
	</section>
</Layout>
<style>
	/* Only for subtitles in sections that have one as a direct child */
	section > p {
		font-size: 1.2rem;
		color: var(--color-text);
		margin-bottom: 1.5rem;
		text-align: center;
	}

	/* Add some spacing between sections on larger screens */
	@media (min-width: 768px) {
		section + section {
			margin-top: 2rem;
		}
	}
</style>
