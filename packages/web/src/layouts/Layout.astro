---
import { Font } from 'astro:assets';

// Import global CSS here
import '@styles/global.css';
import '@styles/tooltips.css';

import { getPlainPathNoLocale, getAbsoluteLocaleUrlFromOrigin} from '@utils/localizedUrl.ts';
import { locales, defaultLocale } from '@languages';

import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import SkipLink from '@components/SkipLink.astro';
import BackToTopButton from '@components/BackToTopButton.astro';

import HeadIcons from '@components/Head/HeadIcons.astro';
import HeadMeta from '@components/Head/HeadMeta.astro';

const locale = Astro.currentLocale || defaultLocale;
const origin = Astro.site ? Astro.site.origin : Astro.url.origin;
// Get the locale-agnostic path (e.g., 'contact' instead of '/en/contact' or '/my-repo/en/contact')
const plainPathNoLocale = getPlainPathNoLocale(Astro.url.pathname, locale);

interface Props {
	title: string;
	description?: string;
	includeLocaleSelector?: boolean;
}

const { title, description, includeLocaleSelector = true } = Astro.props;

// Comprobamos si nos han pasado un slot llamado "sidebar"
const hasSidebar = Astro.slots.has('sidebar');
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<Font cssVariable="--font-roboto" preload />

		<HeadMeta title={title} description={description} />
		<HeadIcons />

		{/* --- SEO: HREFLANG TAGS (for search engines to serve links in the user's language) --- */}
    {/* x-default (mandatory fallback to default locale, usually points to English) */}
    <link 
      rel="alternate" 
      hreflang="x-default" 
      href={getAbsoluteLocaleUrlFromOrigin(origin, defaultLocale, plainPathNoLocale)} 
    />
    
    {/* Dynamically map all our supported locales */}
    {locales.map((loc) => (
      <link 
        rel="alternate" 
        hreflang={loc} 
        href={getAbsoluteLocaleUrlFromOrigin(origin, loc, plainPathNoLocale)} 
      />
    ))}
	</head>
	<body id="top">
		<SkipLink />
		<Header includeLocaleSelector={includeLocaleSelector} />
		
    {/* Renderizado condicional basado en la existencia del sidebar */}
    {hasSidebar ? (
      <div class="layout-with-sidebar">
        <aside class="sidebar">
          <slot name="sidebar" />
        </aside>
        <main id="main-content" class="main-content-area">
          <slot />
        </main>
      </div>
    ) : (
      <main id="main-content">
        <slot />
      </main>
    )}

		<Footer />
		<BackToTopButton />
	</body>
</html>

<style>
  /* CSS Base para cuando hay un sidebar (Aplicando la técnica de 3 columnas) */
  .layout-with-sidebar {
    display: grid;
    /* Columna 1: Sidebar, Columna 2: Contenido, Columna 3: Espejo vacío para centrar */
    grid-template-columns: 280px minmax(0, 1000px) 280px;
    gap: 2rem;
    justify-content: center;
    align-items: start;
    margin: 0 auto;
    padding: 2rem;
  }

	.layout-with-sidebar .main-content-area {
		width: 100%; /* Make sure the content uses all the available width */
	}

	/* En tablets, hacemos 2 columnas en vez de 3 de forma que el contenido tome todo el espacio disponible por la derecha
	/* (no pasa nada porque se quede descentrado por la derecha ya que como no hay mucho espacio queda bien) */
	/* (aquí miramos el max-width a mano según cómo queda bien, no hace falta que en todo el modo tablet se vea así) */
	@media (max-width: 1500px) {
		.layout-with-sidebar {
			grid-template-columns: 280px minmax(0, 1fr);
		}
	}

  /* En móviles, apilamos el TOC arriba del contenido */
  @media (max-width: 1100px) {
    .layout-with-sidebar {
      grid-template-columns: 1fr;
      padding: 1rem;
    }

		.layout-with-sidebar .sidebar {
			/* Remove sticky behavior on mobile, move to top */
			position: relative;
			top: 0;
		}
  }
</style>