---
import { Font } from 'astro:assets';

// Import global CSS here
import '@styles/global.scss';
import '@styles/tooltips.css';

import { getPlainPathNoLocale, getAbsoluteLocaleUrlFromOrigin} from '@utils/localizedUrl.ts';
import { locales, defaultLocale } from '@languages';

import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import SkipLink from '@components/SkipLink.astro';
import FloatingMenu from '@components/FloatingMenu.astro';

import HeadIcons from '@components/Head/HeadIcons.astro';
import HeadMeta from '@components/Head/HeadMeta.astro';
import HeadEasyToReadScript from '@components/Head/HeadEasyToReadScript.astro';

const locale = Astro.currentLocale || defaultLocale;
const origin = Astro.site ? Astro.site.origin : Astro.url.origin;
// Get the locale-agnostic path (e.g., 'contact' instead of '/en/contact' or '/my-repo/en/contact')
const plainPathNoLocale = getPlainPathNoLocale(Astro.url.pathname, locale);

interface Props {
	title: string;
	description?: string;
	includeLocaleSelector?: boolean;
  includeAccessibleFonts?: boolean; // Whether to include accessible fonts (Atkinson Hyperlegible) in the layout. Defaults to false.
}

const { title, description, includeLocaleSelector = true, includeAccessibleFonts = false } = Astro.props;

// Comprobamos si nos han pasado un slot llamado "sidebar"
const hasSidebar = Astro.slots.has('sidebar');
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		{includeAccessibleFonts && <Font cssVariable="--font-atkinson" preload />}
		<Font cssVariable="--font-roboto" preload />

		<HeadMeta title={title} description={description} />
		<HeadIcons />
    <HeadEasyToReadScript />

		{/* --- SEO: HREFLANG TAGS (for search engines to serve links in the user's language) --- */}
    {/* x-default (mandatory fallback to default locale, usually points to English) */}
    <link 
      rel="alternate" 
      hreflang="x-default" 
      href={getAbsoluteLocaleUrlFromOrigin(origin, defaultLocale, plainPathNoLocale)} 
    />
    
    {/* Dynamically map all our supported locales */}
    {locales.map((loc) => (
      <link 
        rel="alternate" 
        hreflang={loc} 
        href={getAbsoluteLocaleUrlFromOrigin(origin, loc, plainPathNoLocale)} 
      />
    ))}
	</head>
	<body id="top">
		<SkipLink />
		<Header includeLocaleSelector={includeLocaleSelector} />
		
    {/* Renderizado condicional basado en la existencia del sidebar */}
    {hasSidebar ? (
      <div class="layout-with-sidebar">
        <aside class="sidebar">
          <slot name="sidebar" />
        </aside>
        <main id="main-content">
          <slot />
        </main>
      </div>
    ) : (
      <main id="main-content">
        <slot />
      </main>
    )}

		<Footer />
		<FloatingMenu />
	</body>
</html>

<style>
  /* CSS Base para cuando hay un sidebar (Aplicando la técnica de 3 columnas) */
  .layout-with-sidebar {
    display: grid;
    /* Columna 1: Sidebar, Columna 2: Contenido, Columna 3: Espejo vacío para centrar */
    /* Note: We make the right empty column a bit shorter than the left sidebar so that it feels like the content takes some needed space for itself and doesn't look like it's not making use of available space, while keeping it looking visually centered */
    grid-template-columns: minmax(280px, 350px) minmax(0, 1000px) 140px;
    gap: 2rem;
    justify-content: center;
    align-items: start;
    margin: 0 auto;
    padding: 2rem;
  }

  html.easy-to-read .layout-with-sidebar {
    grid-template-columns: minmax(280px, 350px) minmax(0, 1fr); /* Let the sidebar and right column take as much space as they need for larger font sizes */
  }

	.layout-with-sidebar #main-content {
		width: 100%; /* Make sure the content uses all the available width */
	}

  .layout-with-sidebar .sidebar {
    /* Sticky positioning keeps it visible when scrolling the main content */
    position: sticky;
    top: 2rem;
    background-color: var(--color-background);
    border: 1px solid var(--color-logo-light-blue);
    border-radius: 8px;
    padding: 1rem 0;

    /* Responsive width */
    width: fit-content; /* Se encoge para abrazar el texto, evitando ocupar espacio vacío */
    min-width: min(50px, 100%); /* Asegura un ancho mínimo para que sea cómodo de leer, pero usa el 100% si la pantalla es enana */
    max-width: 100%; /* Tope de seguridad para que un título larguísimo no rompa el diseño */

    max-height: calc(100vh - 4rem);
    overflow-y: auto; /* Allow scrolling within the sidebar if it gets too long */
    z-index: 10; /* Ensure it stays above other content */
  }

	/* En tablets, hacemos 2 columnas en vez de 3 de forma que el contenido tome todo el espacio disponible por la derecha
	/* (no pasa nada porque se quede descentrado por la derecha ya que como no hay mucho espacio queda bien) */
	/* (aquí miramos el max-width a mano según cómo queda bien, no hace falta que en todo el modo tablet se vea así) */
	@media (max-width: 1500px) {
		.layout-with-sidebar {
			grid-template-columns: minmax(280px, 350px) minmax(0, 1fr);
		}
	}

  /* En móviles, apilamos el TOC arriba del contenido */
  @media (max-width: 1115px) {
    .layout-with-sidebar,
    html.easy-to-read .layout-with-sidebar {
      grid-template-columns: 1fr;
      padding: 1rem;
    }

		.layout-with-sidebar .sidebar {
			/* Remove sticky behavior on mobile, move to top */
			position: relative;
			top: 0;
      max-height: none;
      margin-bottom: 2rem;
      
      /* En vista móvil (cuando se apila arriba o abajo del contenido) 
         sí nos interesa que recupere todo el ancho disponible */
      width: 100%;
		}

    .layout-with-sidebar #main-content {
      /* Remove the padding from the main content because layout-with-sidebar already has padding */
      padding: 0;
    }
  }

  /* On print, we want to hide the sidebar and make the content take the full width */
  @media print {
    .layout-with-sidebar {
      display: block;
      padding: 0;
    }

    .layout-with-sidebar .sidebar {
      display: none;
    }

    #main-content {
      display: block;
    }
  }
</style>