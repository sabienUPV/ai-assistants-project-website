{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*", "../core/src/types", "../core/src/types"],
  "exclude": ["dist"],
  "compilerOptions": {
    "paths": {
      "@languages": ["./src/languages.ts"],
      "@constants": ["./src/constants.ts"],
      "@schemas/*": ["./src/schemas/*"],
      "@markdoc-tags": ["./src/markdoc-tags.ts"],
      "@core-utils/*": ["./src/utils/*"],
      "@core-types/*": ["./src/types/*"],
    }
  }
}
