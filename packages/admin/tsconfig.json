{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@admin-assets/*": ["./src/assets/*"],
      "@styles/*": ["./src/styles/*"],
      "@languages": ["../core/src/languages.ts"],
      "@constants": ["../core/src/constants.ts"],
      "@utils/*": ["./src/utils/*"],
      "@schemas/*": ["../core/src/schemas/*"],
      "@markdoc-tags": ["../core/src/markdoc-tags.ts"],
      "@core-utils/*": ["../core/src/utils/*"],
      "@core-types/*": ["../core/src/types/*"],
    }
  }
}
