{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@admin-assets/*": ["./src/assets/*"],
      "@styles/*": ["./src/styles/*"],
      "@languages": ["../core/src/languages.ts"],
      "@utils/*": ["./src/utils/*"]
    }
  }
}
