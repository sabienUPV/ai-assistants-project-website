# OpenAI-compatible LLM API configuration
# Replace this placeholder with an API key from your provider.
LLM_API_KEY=your-api-key
# Use the provider's OpenAI-compatible endpoint; the official OpenAI URL is shown here.
LLM_BASE_URL=https://api.openai.com/v1
# Set the model identifier enabled by your provider.
LLM_MODEL=llama-3.3-70b
