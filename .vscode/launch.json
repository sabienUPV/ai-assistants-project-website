{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "🚀 Dev Web (Astro + Chrome)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "@sabien-upv-astro-cms/web"],
      "console": "integratedTerminal",
      "restart": true,
      "serverReadyAction": {
        "pattern": "ready in|Local:",
        "action": "startDebugging",
        "name": "🌐 Chrome Web"
      }
    },
    {
      "type": "node",
      "request": "launch",
      "name": "🚀 Dev Admin (Astro + Chrome)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "@sabien-upv-astro-cms/admin", "--", "--port", "4322"],
      "console": "integratedTerminal",
      "restart": true,
      "serverReadyAction": {
        "pattern": "ready in|Local:",
        "action": "startDebugging",
        "name": "🌐 Chrome Admin"
      }
    },
    {
      "type": "chrome",
      "presentation": { "hidden": true },
      "request": "launch",
      "name": "🌐 Chrome Web",
      "url": "http://localhost:4321",
      "webRoot": "${workspaceFolder}/packages/web",
      "userDataDir": "${workspaceFolder}/.vscode/chrome-profile-web"
    },
    {
      "type": "chrome",
      "presentation": { "hidden": true },
      "request": "launch",
      "name": "🌐 Chrome Admin",
      "url": "http://localhost:4322",
      "webRoot": "${workspaceFolder}/packages/admin",
      "userDataDir": "${workspaceFolder}/.vscode/chrome-profile-admin"
    }
  ],
  "compounds": [
    {
      "name": "🚀 Dev Full (Web + Admin)",
      "configurations": ["🚀 Dev Web (Astro + Chrome)", "🚀 Dev Admin (Astro + Chrome)"]
    }
  ]
}