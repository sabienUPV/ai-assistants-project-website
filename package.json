{
  "name": "@sabien-upv-astro-cms/monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "web:dev": "npm run -w @sabien-upv-astro-cms/web dev",
    "admin:dev": "npm run -w @sabien-upv-astro-cms/admin dev",
    "web:build": "npm run -w @sabien-upv-astro-cms/web build",
    "admin:build": "npm run -w @sabien-upv-astro-cms/admin build",
    "translate": "npm run -w @sabien-upv-astro-cms/core translate --",
    "translate:posts": "npm run translate -- -i packages/admin/src/content/en/posts -g \"*.mdoc\"",
    "translate:ai-solutions": "npm run translate -- -i packages/web/src/content/ai-solutions/ai-solutions_en.csv --skip-columns \"Name\" \"Company/ Responsible Entity / Creator\"",
    "web:sync-arasaac": "npm run -w @sabien-upv-astro-cms/web sync:arasaac"
  }
}